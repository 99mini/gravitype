---
// 단일 화면. 라우팅 없음. 페이지 셸은 빌드 타임에 정적 생성되고,
// 물리 엔진은 이후 PR 에서 client 스크립트로만 실행된다 (SSR 없음).
const title = "Gravitype";
const description = "타이핑한 글자가 물리 객체가 되어 떨어지고, 쌓이고, 무너지는 웹 장난감";

// base 설정('/gravitype') 유무·트레일링 슬래시와 무관하게 안전한 자산 경로
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no"
    />
    <meta name="theme-color" content="#0b0b10" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <main id="stage">
      <canvas id="stage-canvas"></canvas>
      <p id="hint">아무 글자나 쳐 보세요</p>
      <button id="motion-hint" hidden>📱 기울여서 무너뜨리기</button>
      <input id="letter-input" type="text" placeholder="여기에 입력" aria-label="글자 입력" />
    </main>
  </body>
</html>

<script>
  import { MOTION, WORLD } from "../lib/constants";
  import { keepFocusForDesktop, wireLetterInput } from "../lib/input";
  import { setupMotion } from "../lib/motion";
  import { mountStage } from "../lib/stage";

  const canvas = document.querySelector<HTMLCanvasElement>("#stage-canvas");
  const hint = document.querySelector<HTMLParagraphElement>("#hint");
  const input = document.querySelector<HTMLInputElement>("#letter-input");
  const motionHint = document.querySelector<HTMLButtonElement>("#motion-hint");
  if (!canvas || !input) {
    throw new Error("#stage-canvas / #letter-input 을 찾지 못했다");
  }

  const stage = mountStage(canvas, { onFirstSpawn: () => hint?.remove() });

  // 물리 바닥을 입력 박스 위로 올려서 쌓인 글자가 가려지지 않게 한다
  function updateFloor() {
    const inputTop = input!.getBoundingClientRect().top;
    stage.setFloorInset(window.innerHeight - inputTop + WORLD.floorGapPx);
  }
  updateFloor();
  window.addEventListener("resize", updateFloor);

  // 글자를 몇 개 쌓은 뒤에 기울기/흔들기를 켠다 (iOS 는 힌트 버튼으로 권한 요청)
  let spawnCount = 0;
  let motionArmed = false;
  wireLetterInput(input, {
    onChar: (char) => {
      stage.spawnLetter(char);
      spawnCount++;
      if (!motionArmed && spawnCount >= MOTION.promptAfterLetters) {
        motionArmed = true;
        setupMotion(stage, motionHint);
      }
    },
  });

  // 캔버스를 탭해도 입력 박스로 focus (click 은 신뢰된 제스처라 키보드가 뜬다)
  canvas.addEventListener("click", () => input.focus({ preventScroll: true }));

  // PC 에서는 별도 탭 없이 바로 타이핑
  keepFocusForDesktop(input);
</script>

<style>
  /* 처음부터 어두운 배경 하나로 간다 (PRD §7 — 다크모드 토글 없음) */
  :global(html, body) {
    margin: 0;
    height: 100%;
    overflow: hidden;
    background: #0b0b10;
    color: #e8e8ef;
    font-family: system-ui, sans-serif;
    overscroll-behavior: none;
    -webkit-tap-highlight-color: transparent;
  }

  #stage {
    position: fixed;
    inset: 0;
  }

  #stage-canvas {
    position: absolute;
    inset: 0;
    touch-action: none;
  }

  /* 입력 박스 — safe-area 하단 중앙, 반투명 (PRD §5 하단 바 자리) */
  #letter-input {
    position: fixed;
    left: 50%;
    transform: translateX(-50%);
    bottom: calc(env(safe-area-inset-bottom, 0px) + 16px);
    width: min(70vw, 280px);
    padding: 10px 16px;
    /* 16px 미만이면 iOS 가 focus 시 화면을 확대한다 */
    font-size: 18px;
    text-align: center;
    color: #e8e8ef;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 999px;
    outline: none;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  #letter-input::placeholder {
    color: #9a9aa8;
  }

  #letter-input:focus {
    border-color: rgba(255, 255, 255, 0.35);
  }

  /* 기울기 권한 힌트 — 상단 중앙, 탭하면 iOS 권한 요청 */
  #motion-hint {
    position: fixed;
    top: calc(env(safe-area-inset-top, 0px) + 16px);
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    font-size: 14px;
    color: #e8e8ef;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  #hint {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    font-size: 1rem;
    color: #9a9aa8;
    user-select: none;
    pointer-events: none;
  }
</style>
