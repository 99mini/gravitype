---
// 단일 화면. 라우팅 없음. 페이지 셸은 빌드 타임에 정적 생성되고,
// 물리 엔진은 이후 PR 에서 client 스크립트로만 실행된다 (SSR 없음).
const title = "Gravitype";
const description = "타이핑한 글자가 물리 객체가 되어 떨어지고, 쌓이고, 무너지는 웹 장난감";

// base 설정('/gravitype') 유무·트레일링 슬래시와 무관하게 안전한 자산 경로
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no"
    />
    <meta name="theme-color" content="#0b0b10" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <main id="stage">
      <canvas id="stage-canvas"></canvas>
      <p id="hint">탭해서 글자를 떨어뜨려 보세요</p>
    </main>
  </body>
</html>

<script>
  import { mountStage } from "../lib/stage";

  const canvas = document.querySelector<HTMLCanvasElement>("#stage-canvas");
  const hint = document.querySelector<HTMLParagraphElement>("#hint");
  if (!canvas) {
    throw new Error("#stage-canvas 를 찾지 못했다");
  }

  const stage = mountStage(canvas, { onFirstSpawn: () => hint?.remove() });

  // 키보드 입력은 다음 PR — 지금은 탭할 때마다 샘플 글자를 떨어뜨린다
  const sample = [..."가나다라마바사아자차카타파하구름별빛바람웃음?!"];
  canvas.addEventListener("pointerdown", () => {
    const char = sample[Math.floor(Math.random() * sample.length)];
    if (char) {
      stage.spawnLetter(char);
    }
  });
</script>

<style>
  /* 처음부터 어두운 배경 하나로 간다 (PRD §7 — 다크모드 토글 없음) */
  :global(html, body) {
    margin: 0;
    height: 100%;
    overflow: hidden;
    background: #0b0b10;
    color: #e8e8ef;
    font-family: system-ui, sans-serif;
    overscroll-behavior: none;
    -webkit-tap-highlight-color: transparent;
  }

  #stage {
    position: fixed;
    inset: 0;
  }

  #stage-canvas {
    position: absolute;
    inset: 0;
    touch-action: none;
  }

  #hint {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    font-size: 1rem;
    color: #9a9aa8;
    user-select: none;
    pointer-events: none;
  }
</style>
